# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — real keys never get committed.

# --- Supabase (Project Settings -> API) ---
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security. Never prefix this with NEXT_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=

# --- ImageKit (Dashboard -> Developer Options -> API Keys) ---
# Safe to expose to the browser:
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# Server-only. Signs browser uploads. Never prefix this with NEXT_PUBLIC_:
IMAGEKIT_PRIVATE_KEY=
